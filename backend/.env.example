# Environment
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/checkin

# Redis (for Bull Queue / Distributed Job Processing / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=checkin  # Prefix for Redis keys to avoid conflicts

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Alternative for Socket.IO

# Rate Limiting
THROTTLE_TTL=60000  # TTL for rate limiting in ms (default 1 min)
THROTTLE_LIMIT=100  # Max requests per TTL window
THROTTLE_SHORT_TTL=10000  # Short burst TTL in ms (10 sec)
THROTTLE_SHORT_LIMIT=300  # Max requests in short window

# File Upload
MAX_FILE_SIZE=10485760  # Max file size in bytes (10MB)
UPLOAD_DEST=./uploads  # Upload destination directory

# API
API_VERSION=1  # API version prefix
API_PREFIX=api  # API route prefix

# Check-in Settings
CHECKIN_LATE_THRESHOLD_MINUTES=10  # Minutes after session start to mark check-in as late

# Session Scheduler
AUTO_OPEN_MINUTES_BEFORE=10  # Minutes before session start to auto-open for check-in
SESSION_CHECK_INTERVAL_MS=30000  # Scheduler check interval in ms (30 sec)
AUTO_END_ENABLED=true  # Enable automatic session ending
AUTO_END_GRACE_MINUTES=0  # Grace period after end time before auto-ending (minutes)